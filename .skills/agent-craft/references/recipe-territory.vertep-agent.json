{
  "format": "vertep-canvas",
  "version": 1,
  "kind": "agent",
  "title": "Territory board",
  "agent": {
    "formatVersion": 1,
    "id": "territory-board",
    "version": "1.0.0",
    "name": "Territory board",
    "description": "Keeps a board of 8 by 6 tiles for a story that names its map squares: seen, taken, dangerous, a settlement. The board is in the floating window.",
    "author": "Molfar",
    "trigger": {
      "when": "after",
      "everyN": 1,
      "keywords": []
    },
    "models": {
      "fast": {
        "hint": "cheap, short answers"
      }
    },
    "limits": {
      "maxCalls": 1,
      "concurrency": 1
    },
    "state": {
      "tiles": {
        "type": "list",
        "item": {
          "x": "number",
          "y": "number",
          "kind": "text"
        },
        "max": 150
      }
    },
    "panels": [
      {
        "id": "board",
        "title": "Territory",
        "place": "float",
        "widgets": [
          {
            "w": "grid",
            "label": "Map",
            "bind": "tiles",
            "cols": 8,
            "rows": 6,
            "x": "x",
            "y": "y",
            "cell": "kind",
            "legend": [
              {
                "value": "explored",
                "label": "Explored",
                "tone": "info",
                "mark": "○"
              },
              {
                "value": "claimed",
                "label": "Ours",
                "tone": "ok",
                "mark": "⚑"
              },
              {
                "value": "danger",
                "label": "Danger",
                "tone": "bad",
                "mark": "!"
              },
              {
                "value": "town",
                "label": "Settlement",
                "tone": "accent",
                "mark": "⌂"
              }
            ]
          }
        ]
      }
    ]
  },
  "nodes": [
    {
      "id": "in",
      "type": "agent.input",
      "x": 10,
      "y": 100,
      "title": "Input",
      "params": {
        "give": [
          {
            "id": "reply",
            "source": "lastReply"
          }
        ]
      }
    },
    {
      "id": "ask",
      "type": "model.ask",
      "x": 260,
      "y": 100,
      "title": "Which tile changed",
      "params": {
        "role": "fast",
        "prompt": "The story plays on a map of 8 columns (1 to 8, from west to east) and 6 rows (1 to 6, from north to south). Did the scene below show or change one tile of that map? If yes, give its column x, its row y and its kind: explored (the heroes saw it), claimed (the heroes took it), danger (a threat sits there) or town (a settlement). Use the squares the story names. If no tile changed, kind is none. Answer with JSON only.\n\n{{reply}}",
        "answer": {
          "as": "json",
          "shape": {
            "kind": "enum:none|explored|claimed|danger|town",
            "x": "number",
            "y": "number"
          }
        },
        "maxTokens": 60,
        "batchKey": null
      }
    },
    {
      "id": "ok",
      "type": "logic.if",
      "x": 520,
      "y": 100,
      "title": "A tile on the board?",
      "params": {
        "inputs": [
          {
            "id": "kind",
            "type": "text"
          },
          {
            "id": "x",
            "type": "number"
          },
          {
            "id": "y",
            "type": "number"
          }
        ],
        "match": "all",
        "rows": [
          {
            "left": {
              "from": "wire",
              "port": "kind"
            },
            "op": "neq",
            "right": {
              "value": "none"
            }
          },
          {
            "left": {
              "from": "wire",
              "port": "x"
            },
            "op": "between",
            "right": {
              "value": [
                1,
                8
              ]
            }
          },
          {
            "left": {
              "from": "wire",
              "port": "y"
            },
            "op": "between",
            "right": {
              "value": [
                1,
                6
              ]
            }
          }
        ]
      }
    },
    {
      "id": "put",
      "type": "state.list",
      "x": 780,
      "y": 100,
      "title": "Set the tile",
      "params": {
        "field": "tiles",
        "op": "add",
        "item": {
          "x": "number",
          "y": "number",
          "kind": "text"
        }
      }
    },
    {
      "id": "out",
      "type": "agent.output",
      "x": 1040,
      "y": 100,
      "title": "Output",
      "params": {
        "kind": "state-patch",
        "show": "float"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "in:reply",
      "to": "ask:reply"
    },
    {
      "id": "e2",
      "from": "ask:kind",
      "to": "ok:kind"
    },
    {
      "id": "e3",
      "from": "ask:x",
      "to": "ok:x"
    },
    {
      "id": "e4",
      "from": "ask:y",
      "to": "ok:y"
    },
    {
      "id": "e5",
      "from": "ok:yes",
      "to": "put:when"
    },
    {
      "id": "e6",
      "from": "ask:x",
      "to": "put:x"
    },
    {
      "id": "e7",
      "from": "ask:y",
      "to": "put:y"
    },
    {
      "id": "e8",
      "from": "ask:kind",
      "to": "put:kind"
    },
    {
      "id": "e9",
      "from": "put:done",
      "to": "out:in"
    }
  ]
}
