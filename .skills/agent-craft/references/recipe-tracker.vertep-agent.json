{
  "format": "vertep-canvas",
  "version": 1,
  "kind": "agent",
  "title": "Tension meter",
  "agent": {
    "formatVersion": 1,
    "id": "tension-meter",
    "version": "1.0.0",
    "name": "Tension meter",
    "description": "Keeps a tension number from 0 to 10: danger raises it, calm lowers it. The code counts, the model only names what happened.",
    "author": "Molfar",
    "trigger": {
      "when": "after",
      "everyN": 1,
      "keywords": []
    },
    "models": {
      "fast": {
        "hint": "cheap, short answers"
      }
    },
    "limits": {
      "maxCalls": 1,
      "concurrency": 1
    },
    "state": {
      "tension": {
        "type": "number",
        "min": 0,
        "max": 10,
        "start": 2
      }
    },
    "panels": [
      {
        "id": "tension",
        "title": "Tension",
        "place": "top1",
        "widgets": [
          {
            "w": "meter",
            "label": "Tension",
            "bind": "tension"
          }
        ]
      }
    ]
  },
  "nodes": [
    {
      "id": "in",
      "type": "agent.input",
      "x": 10,
      "y": 100,
      "title": "Input",
      "params": {
        "give": [
          {
            "id": "reply",
            "source": "lastReply"
          }
        ]
      }
    },
    {
      "id": "ask",
      "type": "model.ask",
      "x": 250,
      "y": 100,
      "title": "What happened",
      "params": {
        "role": "fast",
        "prompt": "Read the scene. Is it calm, tense or dangerous right now? Answer with JSON only.\n\n{{reply}}",
        "answer": {
          "as": "json",
          "shape": {
            "mood": "enum:calm|tense|danger"
          }
        },
        "maxTokens": 60,
        "batchKey": null
      }
    },
    {
      "id": "isDanger",
      "type": "logic.if",
      "x": 500,
      "y": 20,
      "title": "Danger?",
      "params": {
        "inputs": [
          {
            "id": "mood",
            "type": "text"
          }
        ],
        "match": "all",
        "rows": [
          {
            "left": {
              "from": "wire",
              "port": "mood"
            },
            "op": "eq",
            "right": {
              "value": "danger"
            }
          }
        ]
      }
    },
    {
      "id": "isCalm",
      "type": "logic.if",
      "x": 500,
      "y": 200,
      "title": "Calm?",
      "params": {
        "inputs": [
          {
            "id": "mood",
            "type": "text"
          }
        ],
        "match": "all",
        "rows": [
          {
            "left": {
              "from": "wire",
              "port": "mood"
            },
            "op": "eq",
            "right": {
              "value": "calm"
            }
          }
        ]
      }
    },
    {
      "id": "up",
      "type": "state.add",
      "x": 750,
      "y": 20,
      "title": "Tension +2",
      "params": {
        "field": "tension",
        "amount": 2
      }
    },
    {
      "id": "down",
      "type": "state.add",
      "x": 750,
      "y": 200,
      "title": "Tension -1",
      "params": {
        "field": "tension",
        "amount": -1
      }
    },
    {
      "id": "any",
      "type": "logic.merge",
      "x": 1000,
      "y": 110,
      "title": "Either changed",
      "params": {
        "count": 2
      }
    },
    {
      "id": "out",
      "type": "agent.output",
      "x": 1220,
      "y": 110,
      "title": "Output",
      "params": {
        "kind": "state-patch",
        "show": "top1"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "in:reply",
      "to": "ask:reply"
    },
    {
      "id": "e2",
      "from": "ask:mood",
      "to": "isDanger:mood"
    },
    {
      "id": "e3",
      "from": "ask:mood",
      "to": "isCalm:mood"
    },
    {
      "id": "e4",
      "from": "isDanger:yes",
      "to": "up:when"
    },
    {
      "id": "e5",
      "from": "isCalm:yes",
      "to": "down:when"
    },
    {
      "id": "e6",
      "from": "up:done",
      "to": "any:i1"
    },
    {
      "id": "e7",
      "from": "down:done",
      "to": "any:i2"
    },
    {
      "id": "e8",
      "from": "any:out",
      "to": "out:in"
    }
  ]
}
